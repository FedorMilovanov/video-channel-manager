  "topic_findings": {
    "bunyan": [
      "Keep the 12 November 1660 arrest and Bedford gaol record spine.",
      "Remove the unbound cinematic detail that Bunyan necessarily had a Bible in his hands at the arrest.",
      "Bind the 9 May 1672 preaching licence separately from the later release narrative.",
      "Do not compress Pilgrim's Progress composition into twelve continuous years in one cell."
    ],
    "judson": [
      "Correct the chronology: New Testament printing completed 19 December 1832; full translation completed 31 January 1834; later revisions continued; major revised quarto edition completed in October 1840.",
      "Reject the solitary-genius/from-scratch legend and retain predecessor Catholic and Baptist language materials.",
      "Treat imprisonment chronology independently from translation-completion chronology."
    ],
    "spurgeon_cholera": [
      "Treat vivid house-to-house and night-call details as retrospective participant recollection when sourced from the Autobiography.",
      "Use the 1855 St James cholera inquiry and John Snow map only for epidemic context, never to infer Spurgeon's exact route.",
      "Avoid modern medical-policy extrapolation."
    ],
    "carey": [
      "Separate fourteen attendees from the subsequent subscription record; do not state that fourteen people each subscribed unless the minute list proves it.",
      "Bind the October 2, 1792 minute-book resolutions and £13 2s 6d separately from the £1 Enquiry-sales addition.",
      "Treat the familiar expanded slogan 'Expect great things from God; attempt great things for God' as a transmission question rather than an automatic verbatim quote."
    ],
    "fuller": [
      "Do not frame Fuller as correcting Calvinism in general; identify the high/hyper-Calvinist inference concerning duty-faith and indiscriminate gospel address.",
      "Distinguish the first edition from the materially corrected 1801 second edition.",
      "Bind Dan Taylor's 1786 response as opposing contemporary primary evidence.",
      "Keep the 1785-to-1792 mission connection explicitly multicausal."
    ],
    "tyndale": [
      "Keep the famous final-prayer formula outside exact reader copy without a contemporary locator.",
      "Use the 1535 autograph prison letter as a stronger human primary artifact than a late martyrdom quotation.",
      "Keep Cologne/Worms printing, English suppression and later imprisonment as separate evidence stages."
    ],
    "stam": [
      "Use U.S. State Department FRUS documents as an independent chronology family alongside mission archives.",
      "Keep vivid rescue details such as money, sleeping bag, milk and rice baskets only at the certainty supported by the exact Wheaton/Princeton document locator.",
      "Do not let later missionary retellings count as independent contemporary witnesses."
    ],
    "sattler": [
      "Use 1527 Schleitheim print/text and the Sattler-Bucer-Capito correspondence before later martyrology.",
      "Keep Sattler's authorship role qualified: leading attribution versus the confession's collective voice.",
      "Do not inflate graphic execution details from Martyrs Mirror into contemporary evidence.",
      "Preserve theological evaluation of Schleitheim pacifism separately from admiration for Sattler's courage."
    ]
  },
