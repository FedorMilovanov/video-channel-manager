# Core
VCM_ENVIRONMENT=development
VCM_LOG_LEVEL=INFO
VCM_DATA_DIR=./data
VCM_DATABASE_URL=sqlite:///./data/video_manager.db

# Safety
VCM_SAFE_MODE=true
VCM_ALLOW_DESTRUCTIVE_OPERATIONS=false
VCM_MAX_OPERATIONS_PER_PLAN=1000
VCM_REQUIRE_EXPECTED_REVISION=true

# Future YouTube OAuth
VCM_YOUTUBE_CLIENT_ID=
VCM_YOUTUBE_CLIENT_SECRET=
VCM_YOUTUBE_TOKEN_FILE=./data/secrets/youtube-token.json

# Future VK OAuth
VCM_VK_APP_ID=
VCM_VK_ACCESS_TOKEN=
VCM_VK_API_VERSION=5.199
